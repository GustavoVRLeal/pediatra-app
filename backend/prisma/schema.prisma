// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  crm       String   @unique
  createdAt DateTime @default(now())

  patients Patient[]
}

model Patient {
  id            String   @id @default(uuid())
  name          String
  birthDate     DateTime
  weight        Float
  height        Float
  guardianName  String
  guardianEmail String
  guardianPhone String

  pediatricianId String
  pediatrician   User   @relation(fields: [pediatricianId], references: [id])

  forms Form[]

  createdAt DateTime @default(now())
}

model Form {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      FormStatus @default(DRAFT)

  publicToken String? @unique

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  questions Question[]
  responses FormResponse[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Question {
  id       String       @id @default(uuid())
  question String
  type     QuestionType
  required Boolean      @default(false)
  order    Int
  options  String[]     @default([]) /* Opções de resposta, usadas apenas em MULTIPLE_CHOICE */

  formId String
  form   Form   @relation(fields: [formId], references: [id])

  answers Answer[]
}

model Answer {
  id     String @id @default(uuid())
  answer String

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  formResponseId String?
  formResponse   FormResponse? @relation(fields: [formResponseId], references: [id])
}

enum FormStatus {
  DRAFT /* Formulário sendo criado pelo pediatra */
  SENT /* Formulário enviado ao responsável */
  ANSWERED /* Responsável respondeu */
  CLOSED /* Formulário encerrado, sem permitir novas respostas */
}

enum QuestionType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  MULTIPLE_CHOICE
}

model FormResponse {
  id String @id @default(uuid())

  formId String
  form   Form   @relation(fields: [formId], references: [id])

  answers Answer[]

  submittedAt DateTime @default(now())
}
